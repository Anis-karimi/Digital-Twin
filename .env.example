# Digital-Twin Environment Configuration Example
# Copy this file to .env or .env.local to override defaults

# --- Local PC Development Defaults ---
# When running on Local PC (either via 'npm run dev' or 'docker compose up'):
# Requests route automatically via Vite proxy to your local backend on port 7000.
BACKEND_PROXY_URL=http://localhost:7000
LEGACY_BACKEND_PROXY_URL=http://172.20.13.39:8506

# --- Server Deployment Defaults ---
# When running on Server (via 'docker compose -f docker-compose.server.yml up -d'):
# BACKEND_PROXY_URL=http://bot_svc:7000
# LEGACY_BACKEND_PROXY_URL=http://172.20.13.39:8506

# Optional: Direct media and WebSocket services
VITE_DGTW_URL=https://dgtw.um.ac.ir
VITE_STT_WS_URL=wss://172.20.13.39:8881/ws
