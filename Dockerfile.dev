FROM node:20-alpine

WORKDIR /app

# Ensure development environment
ENV NODE_ENV=development

# Copy dependency definitions and npm configuration
COPY package*.json .npmrc* ./

# Install dependencies cleanly including devDependencies
RUN npm install --include=dev

# Copy application source code
COPY . .

# Copy entrypoint script to ensure node_modules/vite exist at runtime even on empty volume mounts
COPY entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh

# Expose Vite development port
EXPOSE 5173

ENTRYPOINT ["/usr/local/bin/entrypoint.dev.sh"]

# Start Vite dev server bound to 0.0.0.0
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
